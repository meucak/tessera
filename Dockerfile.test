FROM node:22-alpine

RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    font-noto

WORKDIR /e2e
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

RUN npm init -y >/dev/null 2>&1 \
    && npm install --no-audit --no-fund playwright-core axe-core

ENV CHROMIUM_PATH=/usr/bin/chromium-browser

CMD ["node", "/app/tests/e2e/run_e2e.mjs"]
